{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chi-zha-de-ordering",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-08-18",
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		"MERCHANT_HOSTNAME": "chi-zha-de-ordering.yeoeb55688.workers.dev",
		"CF_ACCESS_TEAM_DOMAIN": "https://yeoeb.cloudflareaccess.com",
		"CF_ACCESS_AUD": "0b41555c46401f25d421053db77ca92f2ee8e57e91a32f647b2aa6fdd08928b4",
		"NOTIFICATION_PROVIDER": "disabled"
	},
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chi-zha-de-db",
			"database_id": "d104f4b2-1be3-4d4b-b781-008807206dd3",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "ORDER_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	]
}
