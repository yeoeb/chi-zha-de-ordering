# Copy to .dev.vars for local Merchant API/UI access. Never set this bypass in production.
MERCHANT_DEV_BYPASS=true
MERCHANT_DEV_ACTOR_SUBJECT=local-development-merchant
ADMIN_DEV_BYPASS=true
ADMIN_DEV_ACTOR_SUBJECT=local-development-admin
PUBLIC_WRITE_RATE_LIMIT_DEV_BYPASS=true

# Generate a local-only value of at least 32 bytes. Production uses a Worker secret binding.
# AUDIT_ACTOR_HASH_KEY=replace-with-local-random-value-at-least-32-bytes

# Optional local Web Push configuration. Generate development-only VAPID keys outside Git.
# VAPID_PUBLIC_KEY=development-public-key
# VAPID_PRIVATE_KEY=development-private-key
# VAPID_SUBJECT=mailto:developer@example.com

# Production only: set this to the exact Cloudflare Access-protected Merchant hostname.
# MERCHANT_HOSTNAME=merchant.example.com
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-audience-tag

# Production Admin access must use a separate Access application and hostname.
# ADMIN_HOSTNAME=admin.example.com
# ADMIN_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# ADMIN_ACCESS_AUD=your-distinct-admin-access-application-audience-tag
