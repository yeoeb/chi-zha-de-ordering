{
	"name": "chi-zha-de-ordering",
	"description": "Local-first ordering system for the single-store chicken shop 吃炸的",
	"dependencies": {
		"@block65/webcrypto-web-push": "^2.0.0",
		"hono": "^4.13.7",
		"jose": "^6.2.12",
		"react": "19.2.1",
		"react-dom": "19.2.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.57.2",
		"@cloudflare/vitest-plugin": "^1.2.2",
		"@eslint/js": "9.39.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "24.10.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"jsdom": "^30.0.1",
		"qrcode": "^1.5.4",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"vitest": "^4.1.11",
		"wrangler": "4.136.2"
	},
	"private": true,
	"scripts": {
		"build": "node scripts/verify-pwa.mjs && tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "npm run lint && npm run build",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:seed:local": "wrangler d1 execute DB --local --file=seeds/development.sql && npm run db:spice:local",
		"db:spice:local": "wrangler d1 execute DB --local --file=seeds/ensure-spice-modifiers.sql",
		"dev": "vite",
		"generate:onsite-qr": "node scripts/generate-onsite-qr.mjs",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"test": "npm run test:worker && npm run test:dom",
		"test:dom": "vitest run --config vitest.dom.config.ts",
		"test:worker": "vitest run --config vitest.config.ts",
		"verify:deploy-dry-run": "node scripts/verify-deployment-dry-run.mjs",
		"verify:fresh-d1": "node scripts/verify-fresh-d1.mjs",
		"verify:production-data": "node scripts/verify-production-data.mjs && node scripts/verify-hotfix-menu.mjs",
		"verify:test-menu": "node scripts/verify-test-menu.mjs",
		"verify:upgrade-d1": "node scripts/verify-migration-0013-upgrade.mjs",
		"verify:pwa": "node scripts/verify-pwa.mjs"
	},
	"type": "module"
}
